{
  "name": "khmer-typing-tutor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "កម្មវិធីរៀនវាយអត្ថបទខ្មែរ យូនីកូដ (Khmer Unicode Typing Tutor)",
  "author": "Khmer Typing Tutor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "node electron/run.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && node electron/run.js\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.khmer.typingtutor",
    "productName": "Khmer Typing Tutor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khmer Typing Tutor"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}

